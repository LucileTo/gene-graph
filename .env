# API keys (this file is git-ignored: never commit it)

# NCBI, used by src/pubmed_extraction.py
# Email sent to NCBI with each request (recommended)
NCBI_EMAIL=
# Optional: raises the limit from 3 to 10 requests/s (https://account.ncbi.nlm.nih.gov/settings/)
NCBI_API_KEY=

# LLM, used by src/associations_llm.py. Any OpenAI-compatible provider works:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1                           (https://console.groq.com/keys)
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  (https://aistudio.google.com/apikey)
#   Mistral     LLM_BASE_URL=https://api.mistral.ai/v1                                (https://console.mistral.ai/api-keys)
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1                             (https://openrouter.ai/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
